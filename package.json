{
  "name": "blazeresolver",
  "version": "0.8.1",
  "description": "Open-source AI harness that turns customer bug reports into reviewed GitHub pull requests",
  "main": "dist/server/src/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build:react": "tsc -p tsconfig.react.json",
    "build:css": "tailwindcss -i ./client/index.css -o ./dist/react/styles.css --minify",
    "build": "npm run build:server && npm run build:cjs && npm run build:react && npm run build:css && npm run build:client",
    "start": "node dist/server/src/server.js",
    "demo": "tsx src/cli/demo.ts",
    "demo:fix": "tsx src/cli/fix-demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.react.json",
    "test": "tsx --import ./src/tests/hermetic.ts --test src/**/*.test.ts",
    "test:e2e": "tsx src/cli/validate-e2e.ts",
    "prepublishOnly": "npm run build:server && npm run build:cjs && npm run build:react && npm run build:css",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/cjs-marker.mjs"
  },
  "keywords": [
    "github-actions",
    "bug-reports",
    "ai-agent",
    "automated-fixes",
    "pull-requests",
    "triage",
    "blazeresolver",
    "customer-support",
    "support-desk",
    "react"
  ],
  "author": "DJ",
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-icons": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-icons": {
      "optional": true
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@lzehrung/codegraph": "^2.3.31",
    "@modelcontextprotocol/client": "^2.1.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "bin": {
    "blazeresolver": "dist/server/src/cli/index.js"
  },
  "files": [
    "dist/server/src",
    "dist/cjs",
    "dist/react",
    "!dist/server/src/tests",
    "!dist/**/*.map",
    "widget",
    "assets"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./dist/server/src/index.d.ts",
      "import": "./dist/server/src/index.js",
      "default": "./dist/server/src/index.js"
    },
    "./handler": {
      "types": "./dist/server/src/handler/index.d.ts",
      "import": "./dist/server/src/handler/index.js",
      "require": "./dist/cjs/src/handler/index.js",
      "default": "./dist/server/src/handler/index.js"
    },
    "./support": {
      "types": "./dist/server/src/support/index.d.ts",
      "import": "./dist/server/src/support/index.js",
      "require": "./dist/cjs/src/support/index.js",
      "default": "./dist/server/src/support/index.js"
    },
    "./timeline": {
      "types": "./dist/server/src/timeline/index.d.ts",
      "import": "./dist/server/src/timeline/index.js",
      "require": "./dist/cjs/src/timeline/index.js",
      "default": "./dist/server/src/timeline/index.js"
    },
    "./react": {
      "types": "./dist/react/react.d.ts",
      "import": "./dist/react/react.js",
      "require": "./dist/react/react.js",
      "default": "./dist/react/react.js"
    },
    "./styles.css": "./dist/react/styles.css",
    "./widget.js": "./widget/widget.js",
    "./assets/blazyy.svg": "./assets/blazyy.svg",
    "./package.json": "./package.json"
  },
  "types": "dist/server/src/index.d.ts",
  "typesVersions": {
    "*": {
      "handler": [
        "dist/cjs/src/handler/index.d.ts"
      ],
      "support": [
        "dist/server/src/support/index.d.ts"
      ],
      "timeline": [
        "dist/server/src/timeline/index.d.ts"
      ],
      "react": [
        "dist/react/react.d.ts"
      ]
    }
  }
}
