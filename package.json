{
  "name": "blazeresolver",
  "version": "0.3.0",
  "description": "Open-source AI harness that turns customer bug reports into reviewed GitHub pull requests",
  "main": "dist/server/src/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:cjs && npm run build:client",
    "start": "node dist/server/src/server.js",
    "demo": "tsx src/cli/demo.ts",
    "demo:fix": "tsx src/cli/fix-demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build:server && npm run build:cjs",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/cjs-marker.mjs"
  },
  "keywords": [
    "ai-agent",
    "customer-support",
    "correlate-engine",
    "guardrails",
    "langgraph",
    "triage",
    "foodtech",
    "kds",
    "blazeresolver"
  ],
  "author": "DJ",
  "license": "Apache-2.0",
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@lzehrung/codegraph": "^2.3.31",
    "@modelcontextprotocol/client": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "bin": {
    "blazeresolver": "dist/server/src/cli/index.js"
  },
  "files": [
    "dist/server/src",
    "dist/cjs",
    "!dist/server/src/tests",
    "!dist/**/*.map",
    "widget"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/server/src/index.d.ts",
      "default": "./dist/server/src/index.js"
    },
    "./handler": {
      "import": {
        "types": "./dist/server/src/handler/index.d.ts",
        "default": "./dist/server/src/handler/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/handler/index.d.ts",
        "default": "./dist/cjs/src/handler/index.js"
      }
    },
    "./widget.js": "./widget/widget.js",
    "./package.json": "./package.json"
  },
  "types": "dist/server/src/index.d.ts",
  "typesVersions": {
    "*": {
      "handler": [
        "dist/cjs/src/handler/index.d.ts"
      ]
    }
  }
}
