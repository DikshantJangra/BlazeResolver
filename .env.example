# Copy to .env. Both the Node server (src/server.ts) and the Python voice service
# (blazeresolver-voice/) load this file; variables already set in the shell win.

# ---- Node server ------------------------------------------------------------
# Port for the API, dashboard and voice WebSocket bridge.
# The Python voice service also reads PORT (default 8080): if you run both, leave
# PORT unset here and set it per process, e.g. `PORT=3001 npm start`.
PORT=3001
NODE_ENV=development
# Example business to load: restaurant (default) or ecommerce.
BLAZE_EXAMPLE=restaurant
# Gemini Live, for real-time voice. Voice runs a built-in simulator when unset.
GEMINI_API_KEY=

# ---- Python voice service (blazeresolver-voice/) ----------------------------
BLAZERESOLVER_API_URL=http://localhost:3001
# Auto-refund threshold in INR used by the voice tools.
AUTO_REFUND_THRESHOLD_INR=300
VOICE_WS_HOST=localhost:8080
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Software support intake
BLAZE_ADMIN_TOKEN=
BLAZE_MODEL=claude-sonnet-5

# Public hosting: let anyone register a project (rate limited). Leave unset for a private server.
BLAZE_OPEN_SIGNUP=false

# Fix engine (self-hosted / closed servers only; ignored while BLAZE_OPEN_SIGNUP=true)
BLAZE_FIX_ENABLED=false
# Fine-grained GitHub token: contents + pull requests + issues write on the repos you register
BLAZE_GITHUB_TOKEN=
# Secret you set on the GitHub webhook (event: Pull requests) pointing at /api/github/webhook
GITHUB_WEBHOOK_SECRET=
# Optional: email customers when their bug is fixed
RESEND_API_KEY=
BLAZE_FROM_EMAIL=
BLAZE_DATA_DIR=.blazeresolver
