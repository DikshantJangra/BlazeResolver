# Copy to .env. Both the Node server (src/server.ts) and the Python voice service
# (blazeresolver-voice/) load this file; variables already set in the shell win.

# ---- Node server ------------------------------------------------------------
# Port for the API, dashboard and voice WebSocket bridge.
# The Python voice service also reads PORT (default 8080): if you run both, leave
# PORT unset here and set it per process, e.g. `PORT=3001 npm start`.
PORT=3001
NODE_ENV=development
# Example business to load: restaurant (default) or ecommerce.
BLAZE_EXAMPLE=restaurant
# Gemini Live, for real-time voice. Voice runs a built-in simulator when unset.
GEMINI_API_KEY=

# ---- Python voice service (blazeresolver-voice/) ----------------------------
BLAZERESOLVER_API_URL=http://localhost:3001
# Auto-refund threshold in INR used by the voice tools.
AUTO_REFUND_THRESHOLD_INR=300
VOICE_WS_HOST=localhost:8080
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Software support intake
BLAZE_ADMIN_TOKEN=
# Model override. Only sent to providers that serve it (a Claude name never goes to Groq); see the AI block below.
BLAZE_MODEL=claude-sonnet-5

# Public hosting: let anyone register a project (rate limited). Leave unset for a private server.
BLAZE_OPEN_SIGNUP=false

# Fix engine (self-hosted / closed servers only; ignored while BLAZE_OPEN_SIGNUP=true)
BLAZE_FIX_ENABLED=false
# Each fix's tests run AI-written code before review, so they run as this dedicated unprivileged user; the server
# must run as root to switch to it. The Docker image sets blaze-sandbox. Without it, fixes stay off unless you set
# BLAZE_ALLOW_UNSANDBOXED_FIXES=true (only for a trusted local setup: tests could then read this server's secrets).
BLAZE_SANDBOX_USER=
BLAZE_ALLOW_UNSANDBOXED_FIXES=false
# Fine-grained GitHub token: contents + pull requests + issues write on the repos you register
BLAZE_GITHUB_TOKEN=
# Secret you set on the GitHub webhook (event: Pull requests) pointing at /api/github/webhook
GITHUB_WEBHOOK_SECRET=
# Optional: email customers when their bug is fixed
RESEND_API_KEY=
BLAZE_FROM_EMAIL=
BLAZE_DATA_DIR=.blazeresolver

# ---- AI (triage & the fix engine) --------------------------------------------
# Paste any AI provider key; the provider is recognized from the key itself.
# Several keys, even from different providers, give automatic failover and rotation:
#   API_KEYS=sk-ant-...,gsk_...,nvapi-...
# Recognized: Anthropic, OpenAI, Gemini, Groq, NVIDIA NIM, DeepSeek, xAI, Cerebras, Fireworks,
# Perplexity, OpenRouter, Hugging Face, Zhipu, GitHub Models. Keys that look like nothing in particular
# (Mistral, Together, Cohere, ...) go in a named variable instead, e.g. MISTRAL_API_KEY=...
# (or set BLAZE_KEY_PROBE=on to have those providers asked once whose key it is).
# Get a key (free tiers marked *):
#   Groq*        https://console.groq.com/keys
#   Gemini*      https://aistudio.google.com/apikey
#   NVIDIA NIM*  https://build.nvidia.com
#   OpenRouter*  https://openrouter.ai/keys
#   Anthropic    https://console.anthropic.com/settings/keys
#   OpenAI       https://platform.openai.com/api-keys
#   DeepSeek     https://platform.deepseek.com/api_keys
# Check what was recognized: npx blazeresolver providers
# blazeresolver:managed
API_KEYS=
# Optional: pin one provider (BLAZE_MODEL, set above, already puts the provider serving that model first).
# BLAZE_PROVIDER=
# Optional: a local Ollama server, or Azure OpenAI (put its key in API_KEYS).
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
