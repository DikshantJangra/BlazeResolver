# Copy to .env in the app that serves the report endpoint (/api/blaze). `npx blazeresolver init` writes this for you.
# The fix workflow doesn't read .env: give it the same AI key(s) as a repo secret with `gh secret set API_KEYS`.

# ---- GitHub -------------------------------------------------------------------
# Fine-grained token: Issues read and write on this one repo, nothing else. The endpoint files reports with it.
# Fine-grained tokens expire (30 days by default): pick a long expiry, and renew it before it lapses.
BLAZE_GITHUB_TOKEN=

# ---- Universal AI Keys (Auto-Detected for All Providers) ----------------------
# Paste ANY AI provider key; provider is automatically recognized from key prefix:
#   Gemini (AIza...), Anthropic (sk-ant-...), OpenAI (sk-...), Groq (gsk_...),
#   NVIDIA NIM (nvapi-...), xAI (xai-...), DeepSeek (deepseek...), OpenRouter, etc.
# Multiple comma-separated keys give instant failover and rotation:
#   API_KEYS=sk-ant-...,gsk_...,AIzaSy...
# Or use numbered keys: API_KEY_1=..., API_KEY_2=...
# Free tier keys:
#   Gemini*      https://aistudio.google.com/apikey
#   Groq*        https://console.groq.com/keys
#   OpenRouter*  https://openrouter.ai/keys
# Check recognized keys anytime: npx blazeresolver providers
API_KEYS=

# ---- Google Antigravity & Agentic Fix Pipeline (Optional overrides) ---------
# Autonomous agent sidecar and fix pipeline. Defaults work automatically with API_KEYS.
# AGY_PORT=7391
# AGY_MODEL=gemini-2.5-pro

# ---- Operational Store / Database (100% Optional) -----------------------------
# - Frontend-only / Serverless apps: NO database required! GitHub Issues & Actions act as the operational store.
# - Fullstack / Backend apps: Connect PostgreSQL / Supabase / Neon if you want ticket & log persistence.
# Ready schemas placed in agents/: SQL (schema.sql), Drizzle (schema.drizzle.ts), Prisma (schema.prisma).
# BLAZE_DATABASE_URL=postgresql://user:password@localhost:5432/blazeresolver

# ---- Report endpoint (optional) -----------------------------------------------
# Only when the widget runs on a different origin than the endpoint.
# BLAZE_ALLOW_ORIGIN=https://www.example.com
# Reports accepted per hour per server instance (default 100).
# BLAZE_RATE_LIMIT_PER_HOUR=100

# ---- Tell customers when their bug is fixed (optional) -------------------------
# Keeps the customer's email in the issue (use a private repo), so the workflow can email them when the fix merges.
# BLAZE_NOTIFY_CUSTOMERS=true
# The workflow sends through Resend; set these two as repo secrets, not here.
# RESEND_API_KEY=
# BLAZE_FROM_EMAIL=

