# Copy to .env in the app that serves the report endpoint (/api/blaze). `npx blazeresolver init` writes this for you.
# The fix workflow doesn't read .env: give it the same AI key(s) as a repo secret with `gh secret set API_KEYS`.

# ---- GitHub -------------------------------------------------------------------
# Fine-grained token: Issues read and write on this one repo, nothing else. The endpoint files reports with it.
# Fine-grained tokens expire (30 days by default): pick a long expiry, and renew it before it lapses.
BLAZE_GITHUB_TOKEN=

# ---- AI (triage & the fix engine) --------------------------------------------
# Paste any AI provider key; the provider is recognized from the key itself.
# Several keys, even from different providers, give automatic failover and rotation:
#   API_KEYS=sk-ant-...,gsk_...,nvapi-...
# Recognized: Anthropic, OpenAI, Gemini, Groq, NVIDIA NIM, DeepSeek, xAI, Cerebras, Fireworks,
# Perplexity, OpenRouter, Hugging Face, Zhipu, GitHub Models. Keys that look like nothing in particular
# (Mistral, Together, Cohere, ...) go in a named variable instead, e.g. MISTRAL_API_KEY=...
# (or set BLAZE_KEY_PROBE=on to have those providers asked once whose key it is).
# Get a key (free tiers marked *):
#   Groq*        https://console.groq.com/keys
#   Gemini*      https://aistudio.google.com/apikey
#   NVIDIA NIM*  https://build.nvidia.com
#   OpenRouter*  https://openrouter.ai/keys
#   Anthropic    https://console.anthropic.com/settings/keys
#   OpenAI       https://platform.openai.com/api-keys
#   DeepSeek     https://platform.deepseek.com/api_keys
# Check what was recognized: npx blazeresolver providers
# blazeresolver:managed
API_KEYS=
# Optional: a model name. Only sent to providers that serve it (a Claude name never goes to Groq), and puts the
# provider that owns it first. In the workflow, set it as the repo variable BLAZE_MODEL.
# BLAZE_MODEL=
# Optional: pin one provider.
# BLAZE_PROVIDER=
# Optional: a local Ollama server, or Azure OpenAI (put its key in API_KEYS).
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=

# ---- Report endpoint (optional) -----------------------------------------------
# Only when the widget runs on a different origin than the endpoint.
# BLAZE_ALLOW_ORIGIN=https://www.example.com
# Reports accepted per hour per server instance (default 100).
# BLAZE_RATE_LIMIT_PER_HOUR=100

# ---- Tell customers when their bug is fixed (optional) -------------------------
# Keeps the customer's email in the issue (use a private repo), so the workflow can email them when the fix merges.
# BLAZE_NOTIFY_CUSTOMERS=true
# The workflow sends through Resend; set these two as repo secrets, not here.
# RESEND_API_KEY=
# BLAZE_FROM_EMAIL=
